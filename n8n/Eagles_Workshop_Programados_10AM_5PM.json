{
  "name": "WORKSHOP - Envíos programados 10AM y 5PM",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 10 * * *"
            }
          ]
        }
      },
      "id": "schedule-10",
      "name": "Todos los días 10 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -900,
        -120
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 17 * * *"
            }
          ]
        }
      },
      "id": "schedule-17",
      "name": "Todos los días 5 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -900,
        120
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "1",
              "name": "supabaseUrl",
              "value": "PEGA_AQUI_TU_SUPABASE_PROJECT_URL",
              "type": "string"
            },
            {
              "id": "2",
              "name": "supabaseServiceRoleKey",
              "value": "PEGA_AQUI_TU_SERVICE_ROLE_KEY",
              "type": "string"
            },
            {
              "id": "3",
              "name": "evolutionApiKey",
              "value": "PEGA_AQUI_TU_EVOLUTION_API_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config",
      "name": "Credenciales privadas",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -650,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $('Credenciales privadas').item.json.supabaseUrl + '/rest/v1/whatsapp_deliveries?select=id,copy_request_ref,campaign_code,caption,scheduled_at,status,retry_count,marketing_copy_assets(id,asset_type,public_url,metadata),whatsapp_groups(id,code,name,group_jid,whatsapp_instances(id,code,instance_name,base_url))&status=eq.scheduled&scheduled_at=lte.' + encodeURIComponent(new Date().toISOString()) + '&order=scheduled_at.asc&limit=20' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            }
          ]
        },
        "options": {}
      },
      "id": "get-due",
      "name": "Buscar envíos que ya tocan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -390,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.data ?? $json.body ?? $json;\nlet rows = raw;\n\nif (typeof rows === 'string') {\n  try { rows = JSON.parse(rows); } catch { throw new Error('No pude convertir la respuesta de Supabase a JSON.'); }\n}\n\nif (!Array.isArray(rows)) rows = rows?.id ? [rows] : [];\n\nreturn rows\n  .filter((row) => row?.id && row?.status === 'scheduled')\n  .map((row) => {\n    const asset = row.marketing_copy_assets;\n    const group = row.whatsapp_groups;\n    const instance = group?.whatsapp_instances;\n    if (!asset?.public_url || !group?.group_jid || !instance?.base_url || !instance?.instance_name) {\n      throw new Error(`El envío ${row.id} no tiene asset, grupo o instancia completos.`);\n    }\n    return { json: row };\n  });"
      },
      "id": "split",
      "name": "Separar envíos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -130,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ (($json.whatsapp_groups.whatsapp_instances.base_url || '').endsWith('/') ? $json.whatsapp_groups.whatsapp_instances.base_url.slice(0, -1) : $json.whatsapp_groups.whatsapp_instances.base_url) + '/message/sendMedia/' + $json.whatsapp_groups.whatsapp_instances.instance_name }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Credenciales privadas').item.json.evolutionApiKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ number: $json.whatsapp_groups.group_jid, mediatype: $json.marketing_copy_assets.asset_type === 'video' ? 'video' : 'image', mimetype: String($json.marketing_copy_assets.metadata?.mime_type || ($json.marketing_copy_assets.asset_type === 'video' ? 'video/mp4' : $json.marketing_copy_assets.public_url.toLowerCase().includes('.png') ? 'image/png' : $json.marketing_copy_assets.public_url.toLowerCase().includes('.webp') ? 'image/webp' : 'image/jpeg')), media: $json.marketing_copy_assets.public_url, caption: $json.caption }) }}",
        "options": {}
      },
      "id": "send",
      "name": "Enviar por Evolution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        130,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Credenciales privadas').item.json.supabaseUrl + '/rest/v1/whatsapp_deliveries?id=eq.' + $('Separar envíos').item.json.id }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ status: 'sent', sent_at: new Date().toISOString(), evolution_message_id: String($json.key?.id || $json.messageId || $json.id || ''), response_payload: $json, error_message: null }) }}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Marcar envío como enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        390,
        0
      ]
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{ $('Credenciales privadas').item.json.supabaseUrl + '/rest/v1/copy_requests?id=eq.' + $('Separar envíos').item.json.copy_request_ref }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            },
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Credenciales privadas').item.json.supabaseServiceRoleKey }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ status: 'published', published_at: new Date().toISOString() }) }}",
        "options": {}
      },
      "id": "mark-published",
      "name": "Marcar copy como publicado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        650,
        0
      ]
    }
  ],
